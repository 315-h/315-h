# ===== 默认大模型：deepseek 或 qwen =====
LLM_PROVIDER=deepseek

# ===== DeepSeek（https://platform.deepseek.com ，OpenAI 兼容）=====
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ===== 通义千问 Qwen（https://dashscope.console.aliyun.com ，OpenAI 兼容）=====
QWEN_API_KEY=
QWEN_MODEL=qwen-plus

# ===== 可选：后端鉴权 =====
# 若设置，前端 config 区的 COZE_API_TOKEN 必须与之完全一致；留空则不校验。
BACKEND_API_KEY=

# ===== 服务端口（本地调试用）=====
PORT=8000
